--// =========================
--// SERVICES
--// =========================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

--// =========================
--// BLACKLIST
--// =========================
local BLACKLIST = {
	7944642771,
	7944642771,
	7944642771
}

local KICK_MESSAGE = "Stop stealing script lil bro."

--// =========================
--// CHECK FUNCTION
--// =========================
local function isBlacklisted(userId)
	for _, id in ipairs(BLACKLIST) do
		if userId == id then
			return true
		end
	end
	return false
end

--// =========================
--// PUNISHMENT (CLIENT ONLY)
--// =========================
local function startLagAndKick()
	-- 🔒 Client-side folder (does NOT replicate)
	local folder = Instance.new("Folder")
	folder.Name = "BlacklistLag"
	folder.Parent = workspace.CurrentCamera

	-- Spawn blocks gradually
	task.spawn(function()
		for i = 1, 1200 do
			local part = Instance.new("Part")
			part.Size = Vector3.new(
				math.random(2, 6),
				math.random(2, 6),
				math.random(2, 6)
			)
			part.Anchored = true
			part.CanCollide = false
			part.Material = Enum.Material.Neon
			part.Color = Color3.fromHSV(math.random(), 1, 1)

			part.CFrame = CFrame.new(
				math.random(-150, 150),
				math.random(5, 120),
				math.random(-150, 150)
			)

			part.Parent = folder

			task.wait(0.02) -- smoother, avoids instant freeze
		end
	end)

	-- Kick after 15 seconds
	task.delay(10, function()
		LocalPlayer:Kick(KICK_MESSAGE)
	end)
end

--// =========================
--// EXECUTION
--// =========================
if isBlacklisted(LocalPlayer.UserId) then
	startLagAndKick()
end
